NODE_ENV=development
PORT=3100
APP_ORIGIN=http://localhost:5173
PUBLIC_APP_URL=https://your-marketplace.example
MONGODB_URI=mongodb://localhost:27017/telegram_marketplace
# Read-only Telescope source database for the catalog sync script.
TELESCOPE_MONGODB_URI=
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_SHARED_PASSWORD=change-me
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=replace-with-a-random-secret
MARKETPLACE_CURRENCY=EUR
# Configure a private S3-compatible bucket for media (e.g. Vultr Object Storage).
S3_ENDPOINT=https://your-region.vultrobjects.com
S3_PUBLIC_ENDPOINT=https://your-region.vultrobjects.com
S3_REGION=us-east-1
S3_BUCKET=your-private-bucket
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
# Read-only Telescope AWS media signing. These values stay server-side.
TELESCOPE_S3_BUCKET=
TELESCOPE_S3_REGION=us-east-1
TELESCOPE_S3_ACCESS_KEY=
TELESCOPE_S3_SECRET_KEY=
# MantaPay payment provider (direct integration)
MANTAPAY_MERCHANT_ID=
MANTAPAY_HASH_KEY=
MANTAPAY_HOSTED_BASE=https://uiservices.mantapay.biz
MANTAPAY_PROCESS_BASE=https://process.mantapay.biz
